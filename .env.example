# Rubika Authentication Configuration
# Phone number format: +989XXXXXXXXX
RUBIKA_PHONE=+989XXXXXXXXX
RUBIKA_PASSWORD=your_password

# Destination Channel (where news will be published)
DESTINATION_CHANNEL=@your_channel
DESTINATION_CHANNEL_ID=123456789

# Owner User ID (has full access)
OWNER_ID=987654321

# Database Configuration
DATABASE_PATH=data/shahed_news.db

# System Settings
POLL_INTERVAL=5
MAX_RETRIES=5
RETRY_BACKOFF=2
STARTUP_MESSAGE_COOLDOWN=3600

# Features
SEND_STARTUP_MESSAGE=true
LOG_LEVEL=INFO

# API Limitations Warning
# Note: rubpy is an unofficial library
# - Requires phone authentication (Session-based)
# - No guaranteed API stability
# - May violate Rubika Terms of Service
# Use at your own risk
